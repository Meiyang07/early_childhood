# Optional local ports
ADMIN_PORT=4175
ADMIN_UI_PORT=5175
WEBSITE_PORT=4174
WEBSITE_UI_PORT=5174
# Accounts, submissions, and uploaded photos stay in this private folder.
ADMIN_DATA_DIR=data

# Access tokens renew automatically until the refresh session expires.
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_REFRESH_TOKEN_DAYS=7
# Use true only when serving the admin over HTTPS.
ADMIN_SECURE_COOKIES=false

# School SMTP account. Get these details from your email provider.
# SMTP_FROM must be an address this account is permitted to send from.
# Port 587 uses STARTTLS; port 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Recovery address for emailed password verification codes.
# Existing accounts with a stored recovery address keep that address.
ADMIN_RECOVERY_EMAIL=

# Optional first-run credentials. Leave blank to use the code defaults.
# These are applied only when the data folder has no admin account.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
